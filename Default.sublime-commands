[
    {
        "caption": "CodeContinue: Configure",
        "command": "code_continue_configure",
        "description": "Configure API endpoint, model, and API key for CodeContinue"
    },
    {
        "caption": "CodeContinue: Suggest",
        "command": "code_continue_suggest",
        "description": "Get a code suggestion from CodeContinue"
    },
    {
        "caption": "Preferences: CodeContinue Settings",
        "command": "edit_settings",
        "args": {
            "base_file": "${packages}/CodeContinue/CodeContinue.sublime-settings",
            "default": "// CodeContinue Settings - User\n// See default settings for available options\n{\n\t$0\n}\n"
        }
    },
    {
        "caption": "Preferences: CodeContinue Key Bindings",
        "command": "edit_settings",
        "args": {
            "base_file": "${packages}/CodeContinue/Default.sublime-keymap",
            "user_file": "${packages}/User/Default (${platform}).sublime-keymap",
            "default": "[\n\t$0\n]\n"
        }
    },
    {
        "caption": "CodeContinue: Switch Model...",
        "command": "code_continue_switch_model",
        "description": "Switch active model for completions, chat, or editing"
    },
    {
        "caption": "CodeContinue: Chat about Selection",
        "command": "code_continue_chat",
        "description": "Chat with LLM about selected code"
    },
    {
        "caption": "CodeContinue: Explain Selection",
        "command": "code_continue_chat",
        "args": {
            "initial_message": "Explain this code in detail: break down the logic, edge cases, and any assumptions."
        },
        "description": "Explain logic and complexity of selected code"
    },
    {
        "caption": "CodeContinue: Find Bugs & Vulnerabilities",
        "command": "code_continue_chat",
        "args": {
            "initial_message": "Analyze this code for potential bugs, edge cases, performance bottlenecks, and security vulnerabilities. Suggest specific fixes."
        },
        "description": "Review selection for bugs, performance issues, and vulnerabilities"
    },
    {
        "caption": "CodeContinue: Generate Unit Tests",
        "command": "code_continue_chat",
        "args": {
            "initial_message": "Generate comprehensive unit tests for this code with thorough edge-case coverage."
        },
        "description": "Generate unit tests with edge-case coverage"
    },
    {
        "caption": "CodeContinue: Edit Selection",
        "command": "code_continue_edit",
        "description": "Rewrite selected code using an instruction"
    },
    {
        "caption": "CodeContinue: Add Docstrings & Types",
        "command": "code_continue_edit",
        "args": {
            "instruction": "Add clean docstrings and type annotations to this code without altering logic."
        },
        "description": "Add type hints and docstrings to selection"
    },
    {
        "caption": "CodeContinue: Optimize & Clean Code",
        "command": "code_continue_edit",
        "args": {
            "instruction": "Refactor and optimize this code for readability, performance, and best practices."
        },
        "description": "Refactor and optimize selection"
    }
